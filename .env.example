# Copy this file to .env and fill it in. Never commit .env.
# Pick one: gemini (free tier) | anthropic (paid) | mock (no AI). If blank, the server uses whichever key is set.
AI_PROVIDER=gemini

# Free key: https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=
# If you get a "provider_404" error, copy a current model name from AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Optional paid alternative
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Set to true to force mock mode even with a key.
MOCK_AI=false

# Only when deployed behind a host's proxy (e.g. Render). Leave blank on your own computer.
TRUST_PROXY=
